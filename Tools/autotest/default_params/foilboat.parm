# foilboat W2 stub defaults
# 1 m RC flight-dev rig; minimal stub on top of rover.parm.
# Throttle on ch3, ground-steering/rudder on ch1 (inherited).
# PR4: SERVO5/6/7 now driven by AR_FoilControl inner-loop outputs
# (k_foilcontrol_canard/main/rudder = SRV functions 190/191/192).
#  SERVO5 = canard flap   (k_foilcontrol_canard = 190)
#  SERVO6 = main flap     (k_foilcontrol_main   = 191)
#  SERVO7 = rudder        (k_foilcontrol_rudder = 192)
SERVO5_FUNCTION 190
SERVO5_MIN 1000
SERVO5_MAX 2000
SERVO6_FUNCTION 191
SERVO6_MIN 1000
SERVO6_MAX 2000
SERVO7_FUNCTION 192
SERVO7_MIN 1000
SERVO7_MAX 2000
# PR2: AHRS + rangefinder plumbing for JSON SITL plant.
# EKF_TYPE=10 uses the JSON-supplied attitude/velocity/position directly,
# skipping the GPS-fix wait so the 1 m rig boots without a sim GPS lock.
AHRS_EKF_TYPE 10
# RNGFND1_TYPE=100 selects the SITL backend, which consumes rng_1 from the
# JSON plant as height above water in metres.
RNGFND1_TYPE 100
# RNGFND1_ORIENT=25 (ROTATION_PITCH_270) marks the instance as downward-facing
# so AR_FoilControl::get_height_above_water() can look it up via orientation.
RNGFND1_ORIENT 25

# PR5: cascaded outer loops + attitude wrappers + V^2 scheduling.
# Gain values lifted from research/flight-dev-rig/04-control-law.md §1.
# Mirror them here so a clean SITL boot reads the spec defaults without
# trusting the in-code AP_GROUPINFO defaults (those can drift on rebase).

# --- Pitch attitude wrapper (§1.1) — theta_cmd -> q_setpoint ---
# PR6: Kd_theta moved from the outer wrapper (FOIL_KD_THETA, removed) to the
# inner pitch-rate PID's D gain (FOIL_Q_RAT_D below). FOIL_PIT_D stays 0.
FOIL_PIT_P    4.0
FOIL_PIT_I    0.5
FOIL_PIT_D    0.0
FOIL_PIT_IMAX 2.0

# --- Inner pitch-rate PID (§1.1) — q_setpoint -> pitch_mix_cmd ---
# PR6: Kd_q absorbs the PR5 manual D-on-q term. Default 0.04 — analytical
# estimate from closed-loop ω_n=30 rad/s, ζ=0.7. Codebase-expert flagged that
# two derivations disagreed (0.009 vs 0.04); SITL step-response sweep across
# {0.01, 0.02, 0.04, 0.08} is queued behind plant v0.2.
FOIL_Q_RAT_P  0.19
FOIL_Q_RAT_I  0.02
FOIL_Q_RAT_D  0.04
FOIL_Q_RAT_IMAX 0.20

# --- Roll attitude wrapper (§1.2) — phi_cmd -> p_setpoint ---
FOIL_ROL_P    0.6
FOIL_ROL_I    0.05
FOIL_ROL_D    0.04
FOIL_ROL_IMAX 0.5

# --- Heading P controller (§1.3) — psi_cmd -> r_setpoint ---
# PR6: refactored from AC_PID to AC_P (Ki_psi=Kd_psi=0). FOIL_YAW_P retains
# its slot index 13; FOIL_YAW_{I,D,IMAX} are dropped (no effect in PR5 anyway).
FOIL_YAW_P    1.0

# --- Height outer (§1.4) — h_cmd -> theta_cmd ---
FOIL_HGT_P    0.35
FOIL_HGT_I    0.08
FOIL_HGT_D    0.20

# --- Speed outer (§1.5) — V_cmd -> throttle [0..1] ---
FOIL_SPD_P    0.35
FOIL_SPD_I    0.10
FOIL_SPD_D    0.00
FOIL_SPD_IMAX 1.0

# --- V^2 gain scheduling (§1.1, PR6 §3 piecewise) ---
FOIL_VCRUISE  3.7
FOIL_VMINSCHD 0.5
# Lower bound on the V^2 scale applied above V_cruise (PR6).
FOIL_SCHED_FL 0.25

# --- Scalar thresholds ---
FOIL_HGT_TGT  0.15
FOIL_VTOFF    1.6
FOIL_HGT_FB   0.06
# PR6 §4 pre-load schedule reference speed (replaces the inline literal).
FOIL_VTO      1.6

# --- Pre-load feed-forward (PR6 §4) ---
# Canard pre-load peaks at +4° (was +6° in PR5) — keeps a 2° margin to
# alpha_stall at V_TO. Quadratic in V/V_TO. Main pre-load peaks at +2°,
# linear in V/V_TO.
FOIL_PRE_CAN  0.0698132   # radians(4.0)
FOIL_PRE_MAIN 0.0349066   # radians(2.0)

# --- Canard lead compensator (PR6 §4) ---
# H(s) = (1 + 0.060 s) / (1 + 0.015 s). Restores ~35 deg PM at omega = 30 rad/s
# after the 55 ms servo lag drops it from ~80 deg to ~22 deg.
FOIL_LEAD_LD  0.060
FOIL_LEAD_LG  0.015
FOIL_LEAD_EN  1

# --- Failsafe duty-cycle saturation trigger (PR7a-D3) ---
# Fraction of inner-loop ticks (0..1) over a 5 s rolling window in which any
# flap is within 0.5 deg of its ±25 deg mechanical limit.  Above this
# threshold (and under the armed gate: foilborne + settled + V > VTO + 0.2),
# the duty trigger fires.  0.40 = 40 % of the 2000-sample window.
# PR7b: param renamed FOIL_SAT_DUTY_THR -> FOIL_SAT_DUTY (the 17-char form
# exceeded the AP_Param 16-char name limit and panicked the autopilot at
# boot).  Index in AR_FoilControl::var_info[] unchanged at slot 24, so any
# stored param value migrates by index.
FOIL_SAT_DUTY 0.40

# --- Failsafe AUTO_DESCEND dwell (PR7a-D1) ---
# Time (ms) the duty trigger must hold continuously under the armed gate
# before AR_FoilControl latches a descent request.  ModeFoilborneHold polls
# the latch on its next 100 Hz tick and calls rover.set_mode(AUTO_DESCEND).
# Default 500 ms is the mid of the spec range [100, 2000].
FOIL_FAIL_DWELL   500
